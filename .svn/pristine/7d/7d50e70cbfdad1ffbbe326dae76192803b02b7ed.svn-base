                    string[] text = new string[3];

                    text[0] = "첫번째 굴삭!";
                    text[1] = "두번째 굴삭!";
                    text[2] = "세번째 굴삭!";

                    prescore += score_.score;

                    if (upperAngle >= -13.0f)
