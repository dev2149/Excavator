    }

    void OnGameEventNotify(GameEvent.TAG tag)
    {
        if (false == Diging.tutorial)
            return;

        if (tag == GameEvent.TAG.DRIVE_FOUL_CONE)
        {
            if(ViveDigScene.instance.IsVR()==false)
                SetMessage("[ff0000]콘[-]에 부딪쳤습니다.");
            else
                SetMessage("<color=#ff0000>콘</color>에 부딪쳤습니다.");
            state = 1000;
        }
        else if (tag == GameEvent.TAG.DRIVE_FOUL_TIME)
        {
            if (ViveDigScene.instance.IsVR() == false)
                SetMessage("시간을 [ff0000]초과[-]하였습니다.");
            else
                SetMessage("시간을 <color=#ff0000>초과</color>하였습니다.");
            state = 1000;
        }
        else if (tag == GameEvent.TAG.DRIVE_FOUL_CENTER)
        {
            if (ViveDigScene.instance.IsVR() == false)
                SetMessage("<color=#ff0000>중간지점</color>을 지나쳤습니다.");
            else
                SetMessage("<color=#ff0000>중간지점</color>을 지나쳤습니다.");
            state = 1000;
        }
        else
        {
            CheckNotify(tag);
        }
    }

    void SetMessage(string text)
    {
        if (null != message) Destroy(message);

        if (ViveDigScene.instance.IsVR() == false)
        {
            LogManager.Instance.Save(text);

            message = NGUITools.AddChild(gameObject, preMessage);
            message.SetActive(true);
            message.GetComponent<UILabel>().text = text;
            message.transform.localPosition = new Vector3(0, 200.0f, 0); //
        }
        else
        {
            ViveDigScene.instance.message.text = text;
        }
    }

    void ResetMessage()
    {
        if (ViveDigScene.instance.IsVR() == false)
        {
            message.GetComponent<UILabel>().text = " ";
        }
        else
        {
            ViveDigScene.instance.message.text = " ";
        }
    }

    [HideInInspector]
    public int safeCount;

    public void SetGuide()
    {
        safeCount++;

        if (safeCount == 2)
        {
            Invoke("NextState", 1.0f);
        }


    }

    void CheckNotify(GameEvent.TAG tag)
    {
        print("stage" + state);

        if (ViveDigScene.instance.IsVR() == false)
        {
            switch (state)
            {
                case 0:
                    if (tag == GameEvent.TAG.DIG_READY)
                    {
                        SetMessage("굴삭모드 연습을 시작하겠습니다.");
                        //++state;
                        // Invoke("NextState", 5.0f);

                        Invoke("NextState", 1.0f);

                        EnableRage();
                    }
                    break;

                case 1:
                    SetMessage("[00ff00]안전벨트[-]를 착용후 안전바를 내려주세요 ");
                    break;

                case 2:

                    if (!this.gameObject.activeSelf)
                        return;

                    string[] text = new string[3];
                    text[0] = "첫번째 굴삭!";
                    text[1] = "두번째 굴삭!";
                    text[2] = "세번째 굴삭!";

                    prescore += score_.score;
                    if (upperAngle >= -13.0f)
                    {
                        if (ViveDigScene.instance.IsVR() == false)
                        {
                            //로그 카운터 저장
                            LogManager.Instance.Save(text[score_.score / 20]);
                        }

                        GuideSound("DigGuide/Guide_002", true);
                        SetMessage(text[score_.score / 20] + "\n[00ff00]첫번째[-], 붐을 올려 주세요.");
                    }
                    else
                    {
                        if (!audio_.isPlaying)
                        {
                            audio_.clip = Resources.Load("DigGuide/Guide_002_d") as AudioClip;
                            audio_.Play();
                        }

                        SetMessage(text[score_.score / 20] + "\n[00ff00]첫번째[-], 붐을 내려 주세요.");
                    }


                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -10.0f, "붐"));
                    EnableRage();

                    break;

                case 3:
                    break;

                case 4:

                    if (foreAngle >= -40.0f)
                    {
                        GuideSound("DigGuide/Guide_003_push", true);
                        SetMessage("[00ff00]두번째[-], 암을 밀어 주세요.");
                    }
                    else
                    {
                        if (!audio_.isPlaying)
                        {
                            audio_.clip = Resources.Load("DigGuide/Guide_003") as AudioClip;
                            audio_.Play();
                        }

                        SetMessage("[00ff00]두번째[-], 암을 당겨 주세요.");
                    }
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.fore, -40.0f, "암"));
                    EnableRage();


                    break;

                case 5:
                    break;

                case 6:
                    if (bucketAngle >= -80.0f)
                    {
                        GuideSound("DigGuide/Guide_004_open", true);
                        SetMessage("[00ff00]세번째[-], 버킷을 열어 주세요.");
                    }
                    else
                    {
                        GuideSound("DigGuide/Guide_004", true);
                        SetMessage("[00ff00]세번째[-], 버킷을 닫아 주세요.");
                    }


                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.bucket, -80.0f, "버킷"));
                    EnableRage();

                    break;

                case 7:
                    break;

                case 8:
                    if (bucketAngle <= -80.0f)
                    {
                        if (upperAngle <= 1.0f)
                        {
                            GuideSound("DigGuide/Guide_002_d", true);
                            SetMessage(" [00ff00]네번째[-], 붐을 내려 주세요.");   // 땅에 있을때.
                        }
                        else
                        {
                            GuideSound("DigGuide/Guide_002", true);
                            SetMessage(" [00ff00]네번째[-], 붐을 올려 주세요.");
                        }


                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.upper, 0f + (score_.score / 8), "붐"));   // 점점 더 땅속으로 내려가게..	
                        EnableRage();
                    }
                    break;

                case 9:
                    break;

                case 10:
                    if (upperAngle >= -4F) // 땅속에서 
                    {


                        if (foreAngle <= -30.0f)
                        {
                            GuideSound("DigGuide/Guide_005", true);
                            SetMessage("[00ff00]다섯번째[-],\n암을 당기면서 버킷을 닫아주세요.");
                            axis = new List<AXIS>();
                            axis.Add(AXIS.Create(diging.bucket, 20.0f, "버킷"));
                            axis.Add(AXIS.Create(diging.fore, -30.0f, "암")); //왔다갔다 한다. 문제가 되고있다.
                        }
                        else
                        {
                            GuideSound("DigGuide/Guide_004", true);
                            axis = new List<AXIS>();
                            SetMessage("[00ff00]다섯번째[-], 버킷을 닫아 주세요.");
                            axis.Add(AXIS.Create(diging.bucket, 20.0f, "버킷"));
                        }

                        EnableRage();

                    }
                    break;

                case 11:
                    break;

                case 12:
                    if (tag == GameEvent.TAG.DIG_DIGGING)
                    {
                        GuideSound("DigGuide/Guide_006", true);
                        SetMessage("[ff0000]흙을 펐습니다.[-]\n 붐을 올려 주세요.");

                        ++state;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.upper, -37.0f, "붐")); //-28 
                        EnableRage();
                    }
                    else
                    {
                        if (bucket.soil.time <= 0.6f)
                        {

                            GuideSound("DigGuide/Guide_002", true);
                            SetMessage("[00ff00]여섯번째[-], 붐을 올려 주세요.");

                            ++state;

                            axis = new List<AXIS>();
                            axis.Add(AXIS.Create(diging.upper, -37.0f, "붐")); //-28
                            EnableRage();
                        }
                        else
                        {

                            GuideSound("DigGuide/Guide_002_d", true);
                            SetMessage(" [00ff00]네번째[-],붐을 내려 주세요.");
                            state = 8;

                            axis = new List<AXIS>();
                            axis.Add(AXIS.Create(diging.upper, 0f + (score_.score / 10), "붐")); // 점점 더 땅속으로 내려가게..	
                            EnableRage();

                        }

                    }
                    break;

                case 13:
                    break;

                case 14:
                    if (bucket.soil.time > 0.6f)
                    {
                        GuideSound("DigGuide/Guide_007", true);
                        SetMessage("[ff0000]이동할 흙량이 부족합니다.[-] \n[00ff00]세번째[-], 버킷을 움직여 주세요.");
                        state = 6;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.bucket, -100.0f, "버킷"));
                        EnableRage();
                    }
                    else
                    {
                        GuideSound("DigGuide/Guide_008_left", true);
                        SetMessage("[00ff00]일곱번째[-], \n케빈을 왼쪽으로 회전해 주세요.");
                        ++state;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.body, -183.0f, "케빈")); //-180
                        EnableRage();
                    }

                    break;

                case 15:
                    break;

                case 16: // 문제 구간.
                    GuideSound("DigGuide/Guide_002_d", true);
                    SetMessage("[00ff00]여덟번째[-], 붐을 내려 주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -20.0f, "붐"));
                    EnableRage();


                    break;

                case 17:
                    break;

                case 18:
                    if (bucket.soil.time < 0.6f)
                    {
                        GuideSound("DigGuide/Guide_009", true);
                        SetMessage("[00ff00]아홉번째[-],\n 버킷을 열면서 암을 밀어 주세요.");
                        ++state;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.fore, -45.0f, "암"));
                        axis.Add(AXIS.Create(diging.bucket, -80.0f, "버킷"));
                        EnableRage();
                    }
                    else
                    {
                        SetMessage("흙량이 부족합니다. 작업영역으로 돌아가세요.");
                        state = 2;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.body, -2.0f, "케빈")); //-180.0f
                        EnableRage();
                    }

                    break;

                case 19:
                    break;

                case 20:

                    GuideSound("DigGuide/Guide_010", true);
                    SetMessage("[00ff00]열번째[-],\n 버킷은 닫고 암을 당기고 붐을 올리세요.");
                    state++;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -37.0f, "붐"));
                    axis.Add(AXIS.Create(diging.fore, -35.0f, "암"));
                    axis.Add(AXIS.Create(diging.bucket, 20.0f, "버킷"));
                    EnableRage();

                    break;

                case 21:

                    break;

                case 22:

                    GuideSound("DigGuide/Guide_008", true);
                    SetMessage("[00ff00]열한번째[-],\n 케빈을 오른쪽으로 회전해 주세요.");

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈")); //-180.0f
                    EnableRage();


                    break;

                case 23:
                    break;

                case 24:
                    if (score_.score >= 60)
                    {
                        GuideSound("DigGuide/Guide_011", true);
                        SetMessage("네번째 굴삭! \n같은 방법으로 1번 더 하세요.");
                        ++state;
                        Invoke("ResetMessage", 3.0f);

                        axis = null;
                        EnableRage();
                    }
                    else
                        state = 1;
                    break;


                case 25:
                    if (GameEvent.TAG.DIG_POUR == tag)
                    {
                        GuideSound("DigGuide/Guide_013", true);
                        SetMessage("[00ff00]평탄 작업을 시작하겠습니다.[-]\n버킷은 열고 암을 당기고 붐을 내리세요.");
                        ++state;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.upper, -6.0f, "붐"));
                        axis.Add(AXIS.Create(diging.fore, -15.0f, "암"));
                        axis.Add(AXIS.Create(diging.bucket, -95.0f, "버킷"));
                        EnableRage();
                    }
                    break;

                case 26:

                    break;

                case 27:
                    stateflat = true; //안전한 작업을 위해 붐을 내려 주세요.
                    SetMessage("[00ff00]평탄 첫번째,[-]\n암을 밀어주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.fore, -42.0f, "암"));
                    EnableRage();
                    break;

                case 28:
                    break;

                case 29:
                    SetMessage("[00ff00]평탄 두번째,[-]\n암을 당기면서 붐을 올려려주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -18.0f, "붐"));
                    axis.Add(AXIS.Create(diging.fore, -30.0f, "암"));
                    EnableRage();
                    stateflat = false;
                    break;

                case 30:
                    break;


                case 31:

                    GuideSound("DigGuide/Guide_014", true);
                    SetMessage("[00ff00]자~ 이제 평탄마지막 단계입니다.[-]\n버킷을 땅에 닿게 해주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -2.0f, "붐"));

                    EnableRage();
                    break;

                case 32:
                    break;

                case 33:

                    GuideSound("DriveGuide/023", true);
                    SetMessage("수고하셨습니다. ");

                    if (ViveDigScene.instance.IsVR() == false)
                    {
                        for (int i = 0; i < ranges.Length; ++i)
                        {
                            ranges[i].gameObject.SetActive(false);
                        }
                    }
                    else
                    {
                        for (int i = 0; i < ranges_vr.Length; ++i)
                        {
                            ranges_vr[i].gameObject.SetActive(false);
                        }
                    }
                    Invoke("NextState", 1.5f);

                    break;
                case 34:
                    Map.SendMessage("ShowTutorial", true);
                    break;

            }
        }
        else //VR
        {
            switch (state)
            {
                case 0:
                    if (tag == GameEvent.TAG.DIG_READY)
                    {
                        SetMessage("굴삭모드 연습을 시작하겠습니다.");
                        //++state;
