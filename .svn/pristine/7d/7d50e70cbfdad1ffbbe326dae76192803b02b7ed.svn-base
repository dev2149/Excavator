            }

            if (state == 10 && upperAngle < -4.0f)
            { //붐을 올리고는 작업이 불가.

                SetMessage("<color=#00ff00>안전한 작업을 위해</color> 붐을 내려 주세요.");
                GuideSound("DigCaution/013", true);
                state = 8;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.upper, 0f + (score_.score / 10), "붐"));
                EnableRage();
            }
            if (stateflat && upperAngle < -10f)
            {

                SetMessage("<color=#00ff00>안전한 작업을 위해</color> 붐을 내려 주세요.");
                GuideSound("DigCaution/013", true);
                state = 26;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.upper, -8.0f, "붐"));
                EnableRage();
            }

            if (state >= 24 && bodyAngle > -180f)
            {
                isSpinFail = true;

                SetMessage("<color=#00ff00>작업영역으로 이동해주세요.</color>");
                state = 26;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.body, -180.0f, "케빈"));
                EnableRage();
            }
            else if (bodyAngle > 10F && state <= 15)
            {
                isSpinFail = true;

                GuideSound("DigCaution/012", true);
                SetMessage("<color=#ff0000>회전방향이 잘못되었습니다.</color> 왼쪽으로 회전해 주세요.");
                axis = new List<AXIS>();
                Diging.AXIS bodyAngleValue = diging.body;

                bodyAngleValue.angle = Mathf.Clamp(diging.body.angle, -100, 100);

                //axis.Add(AXIS.Create(diging.body, -3.0f, "케빈"));    //임의 값		

                axis.Add(AXIS.Create(bodyAngleValue, -3.0f, "케빈")); //임의 값		
                EnableRage();
            }
            else if (bodyAngle < -200F)//&& state >= 20)
            {
                isSpinFail = true;

                GuideSound("DigCaution/012", true);
                SetMessage("<color=#ff0000>회전방향이 잘못되었습니다.</color> 오른쪽으로 회전해 주세요.");

                axis = new List<AXIS>();
                Diging.AXIS bodyAngleValue = diging.body;

                bodyAngleValue.angle = Mathf.Clamp(diging.body.angle, -300F, 300f);

                axis.Add(AXIS.Create(bodyAngleValue, -200.0f, "케빈"));   //임의 값		

                EnableRage();
            }
            else
            {
                isSpinFail = false;
            }

            if (bodyAngle < -14F && state == 2)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("<color=#ff0000>가이드이탈 이동할 흙량이 부족합니다.</color> <color=#00ff00>작업영역으로 이동해주세요.</color>");
                    state = 0;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }


            if (bodyAngle < -14F && state == 5)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("<color=#ff0000>가이드이탈 이동할 흙량이 부족합니다.</color> <color=#00ff00>작업영역으로 이동해주세요.</color>");
                    state = 2;
                    state++;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }

            if (bodyAngle < -14F && state == 6)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("<color=#ff0000>가이드이탈 이동할 흙량이 부족합니다.</color> <color=#00ff00>작업영역으로 이동해주세요.</color>");
                    state = 5;
                    --state;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }

            if (bodyAngle < -14F && state == 8)
            {

                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("<color=#ff0000>가이드이탈 이동할 흙량이 부족합니다.</color> <color=#00ff00>작업영역으로 이동해주세요.</color>");
                    state = 7;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }

            if (bodyAngle < -10F && state == 13)
            {
                if (bucket.soil.time > 0.6f)
                {
                    state = 11;
                }

                if (bucket.soil.time < 0.6f)
                {
                    SetMessage("<color=#00ff00> 가이드이탈 일곱번째</color>, 케빈을 왼쪽으로 회전해 주세요.");
                    state = 14;
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, -183.0f, "케빈")); //-180.0f
                    EnableRage();
                }
            }


