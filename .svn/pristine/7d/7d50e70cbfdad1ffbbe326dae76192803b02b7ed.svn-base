using UnityEngine;
using System.Collections;
using System.Collections.Generic;
using UnityEngine.UI;

public class DigMessage : MonoBehaviour
{

    public GameObject preMessage;
    public UILabel label;
    public Diging diging;
    public UIAxisRange[] ranges;
    public UIAxisRange[] ranges_vr;
    public GameObject tutorial;
    public digMap Map;
    private AudioClip alram;
    private DigingBucket bucket;
    public AudioSource audio_;


    bool isSpinFail = false;

    public DigingBucket score_; //현재 스코어
    private int prescore; //이전 스코어

    private class AXIS
    {
        public Diging.AXIS @ref;
        public float target;
        public string targetName;
        public bool complete;

        public static AXIS Create(Diging.AXIS _ref, float _target, string _targetName)
        {
            AXIS axis = new AXIS();
            axis.@ref = _ref;
            axis.target = _target;
            axis.targetName = _targetName;
            axis.complete = false;
            return axis;
        }

    }
    private List<AXIS> axis;
    public int state = 0;
    private GameObject message;
    private bool stateflat;


    void Awake()
    {
        GameEvent.notify += OnGameEventNotify;
    }

    void OnDestroy()
    {
        GameEvent.notify -= OnGameEventNotify;
    }

    void Start()
    {
        alram = Resources.Load("띠롱") as AudioClip;
        bucket = GameObject.Find("Bucket").GetComponent<DigingBucket>();

        //평탄화 작업
        //		state = 25;
        //		GameEvent.notify (GameEvent.TAG.DIG_POUR);
        //		bucket.shovelingCount = 4;
    }


    private float bucketAngle;
    private float foreAngle;
    private float upperAngle;
    private float bodyAngle;

    private AudioClip guidemessage;


    void Update()
    {
        if (null == axis)
            return;

      

        if (!Diging.tutorial)
            return;

        bucketAngle = diging.bucket.angle;
        foreAngle = diging.fore.angle;
        upperAngle = diging.upper.angle;
        bodyAngle = diging.body.angle;

       
        


        int cout = 0;
        int i;

        for (i = 0; i < axis.Count; ++i)
        {
            

            float angle = axis[i].@ref.angle; //움직이는 화살표

            float d = axis[i].target - angle;

            if (1.0f >= Mathf.Abs(d))
            {
                ranges_vr[i].gameObject.GetComponent<RawImage>().color = Color.green;
                ranges_vr[i].transform.Find("angle").GetComponent<RawImage>().color = Color.green;
            }
            else
            {
                ranges_vr[i].gameObject.GetComponent<RawImage>().color = Color.white;
                ranges_vr[i].transform.Find("angle").GetComponent<RawImage>().color = Color.white;
            }

            if (true == axis[i].complete)
            {
                ++cout;
                continue;
            }

            if (1.0f >= Mathf.Abs(d))
            {
                axis[i].complete = true;
                NGUITools.PlaySound(alram, DeviceSound.Instance.Effect);
            }

            if (Mathf.Abs(d) >= 190)
            {
                isSpinFail = true;

               // label.text = "[ff0000]회전방향이 잘못되었습니다!![-]";
               // GuideSound("DigCaution/012", true);
            }
            else
            {

                isSpinFail = false;
                label.text = " ";
            }

            GuideCaution();
        }

        if (cout >= axis.Count)
        {
            if (state >= 37)
            {
                return;
            }

            NextState();
           
        }

    }

    void GuideSound(string str, bool on)
    {
        if (!this.gameObject.activeSelf)
            return;

        if (ViveDigScene.instance.IsVR())
        {
            DeviceSound.Instance.PlayG(Resources.Load(str.ToString()) as AudioClip, DeviceSound.Instance.Effect);
            return;
        }

        if (on)
        {
            if (!audio_.isPlaying)
            {
                audio_.clip = Resources.Load(str.ToString()) as AudioClip;
                audio_.Play();
                audio_.volume = DeviceSound.Instance.Effect;
            }
            on = false;
        }
    }

    void GuideCaution()
    {
        if (ViveDigScene.instance.IsVR() == false)
        {
            if (state == 11 && upperAngle <= -7.0f)
            {
                SetMessage("[00ff00]안전한 작업을 위해[-] 붐을 내려 주세요.");
                GuideSound("DigCaution/013", true);
                state = 6;
                state += 2;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.upper, 0.0f, "붐"));
                EnableRage();
            }

            if (state < 10 && bucket.soil.time <= 0.5f)
            {
                state = 12;
                GameEvent.notify(GameEvent.TAG.DIG_DIGGING);
            }

            if (state == 10 && upperAngle < -4.0f)
            { //붐을 올리고는 작업이 불가.

                SetMessage("[00ff00]안전한 작업을 위해[-] 붐을 내려 주세요.");
                GuideSound("DigCaution/013", true);
                state = 8;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.upper, 0f + (score_.score / 10), "붐"));
                EnableRage();
            }
            if (stateflat && upperAngle < -10f)
            {

                SetMessage("[00ff00]안전한 작업을 위해[-] 붐을 내려 주세요.");
                GuideSound("DigCaution/013", true);
                state = 26;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.upper, -8.0f, "붐"));
                EnableRage();
            }

            if (state >= 24 && bodyAngle > -180f)
            {
                isSpinFail = true;

                SetMessage("[00ff00]작업영역으로 이동해주세요.[-]");
                state = 26;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.body, -180.0f, "케빈"));
                EnableRage();
            }
            else if (bodyAngle > 10F && state <= 15)
            {
                isSpinFail = true;

                GuideSound("DigCaution/012", true);
                SetMessage("[ff0000]회전방향이 잘못되었습니다.[-] \n 왼쪽으로 회전해 주세요.");
                axis = new List<AXIS>();
                Diging.AXIS bodyAngleValue = diging.body;

                bodyAngleValue.angle = Mathf.Clamp(diging.body.angle, -100, 100);

                //axis.Add(AXIS.Create(diging.body, -3.0f, "케빈"));    //임의 값		

                axis.Add(AXIS.Create(bodyAngleValue, -3.0f, "케빈")); //임의 값		
                EnableRage();
            }
            else if (bodyAngle < -200F)//&& state >= 20)
            {
                isSpinFail = true;

                GuideSound("DigCaution/012", true);
                SetMessage("[ff0000]회전방향이 잘못되었습니다.[-]\n 오른쪽으로 회전해 주세요.");

                axis = new List<AXIS>();
                Diging.AXIS bodyAngleValue = diging.body;

                bodyAngleValue.angle = Mathf.Clamp(diging.body.angle, -300F, 300f);

                axis.Add(AXIS.Create(bodyAngleValue, -200.0f, "케빈"));   //임의 값		

                EnableRage();
            }
            else
            {
                isSpinFail = false;
            }

            if (bodyAngle < -14F && state == 2)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("[ff0000]가이드이탈 이동할 흙량이 부족합니다.[-] \n[00ff00]작업영역으로 이동해주세요.[-]");
                    state = 0;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }


            if (bodyAngle < -14F && state == 5)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("[ff0000]가이드이탈 이동할 흙량이 부족합니다.[-] \n[00ff00]작업영역으로 이동해주세요.[-]");
                    state = 2;
                    state++;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }

            if (bodyAngle < -14F && state == 6)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("[ff0000]가이드이탈 이동할 흙량이 부족합니다.[-] \n[00ff00]작업영역으로 이동해주세요.[-]");
                    state = 5;
                    --state;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }

            if (bodyAngle < -14F && state == 8)
            {

                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("[ff0000]가이드이탈 이동할 흙량이 부족합니다.[-] \n[00ff00]작업영역으로 이동해주세요.[-]");
                    state = 7;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }

            if (bodyAngle < -10F && state == 13)
            {
                if (bucket.soil.time > 0.6f)
                {
                    state = 11;
                }

                if (bucket.soil.time < 0.6f)
                {
                    SetMessage("[00ff00] 가이드이탈 일곱번째[-], \n케빈을 왼쪽으로 회전해 주세요.");
                    state = 14;
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, -183.0f, "케빈")); //-180.0f
                    EnableRage();
                }
            }


            if (bodyAngle < -14F && state == 15)
            {
                if (bucket.soil.time > 0.6f)
                {
                    SetMessage("[ff0000]가이드이탈 이동할 흙량이 부족합니다.[-] \n[00ff00]작업영역으로 이동해주세요.[-]");
                    state = 12;
                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();
                }
            }
            if (bodyAngle < -14F && state == 17) // 붐을 내려주세요.
            {
                if (bucket.soil.time > 0.6f)
                {
                    state = 18;
                    state += 2;
                }
            }

            if (state == 19)   // 흙을 먼저 버리고 생기는 가이드 이탈.
            {
                if (bucket.soil.time < 0.6f)
                    return;

                //pc 버전 에는  && bodyAngle > -180 이었음.
                else if (bucket.soil.time >= 1.0f)
                {
                    if (bodyAngle > -180) // 케빈을 회전했을때.
                    {
                        GuideSound("DigGuide/Guide_008", true);
                        SetMessage("[00ff00]가이드이탈 열한번째[-],\n 케빈을 오른쪽으로 회전해 주세요.");

                        state = 21;
                        state += 2;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                        EnableRage();
                    }
                }
                else // 회전하지 않았을때.
                {
                    GuideSound("DigGuide/Guide_010", true);
                    SetMessage("[00ff00]열번째[-],\n 버킷은 닫고 암을 당기고 붐을 올리세요.");
                    state++;
                    //				state = 20;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -37.0f, "붐"));
                    axis.Add(AXIS.Create(diging.fore, -35.0f, "암"));
                    axis.Add(AXIS.Create(diging.bucket, 20.0f, "버킷"));
                    EnableRage();
                }
            }

            if (state == 21) //케빈을 회전하려할때.
            {
                if (bodyAngle < -180)
                    return;
                else
                {
                    GuideSound("DigGuide/Guide_008", true);
                    SetMessage("[00ff00]가이드이탈 열한번째[-],\n 케빈을 오른쪽으로 회전해 주세요.");

                    state = 21;
                    state++;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.body, 0.0f, "케빈"));
                    EnableRage();

                    //     print("설마중첩");

                }
            }
        }
        else //VR
        {
            if (state == 11 && upperAngle <= -7.0f)
            {
                SetMessage("<color=#00ff00>안전한 작업을 위해</color> 붐을 내려 주세요.");
                GuideSound("DigCaution/013", true);
                state = 6;
                state += 2;
                axis = new List<AXIS>();
                axis.Add(AXIS.Create(diging.upper, 0.0f, "붐"));
