                case 5:
                    break;

                case 6:
                    if (bucketAngle >= -80.0f)
                    {
                        GuideSound("DigGuide/Guide_004_open", true);
                        SetMessage("<color=#00ff00>세번째</color>, 버킷을 열어 주세요.");
                    }
                    else
                    {
                        GuideSound("DigGuide/Guide_004", true);
                        SetMessage("<color=#00ff00>세번째</color>, 버킷을 닫아 주세요.");
                    }


                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.bucket, -80.0f, "버킷"));
                    EnableRage();

                    break;

                case 7:
                    break;

                case 8:
                    if (bucketAngle <= -80.0f)
                    {
                        if (upperAngle <= 1.0f)
                        {
                            GuideSound("DigGuide/Guide_002_d", true);
                            SetMessage(" <color=#00ff00>네번째</color>, 붐을 내려 주세요.");   // 땅에 있을때.
                        }
                        else
                        {
                            GuideSound("DigGuide/Guide_002", true);
                            SetMessage(" <color=#00ff00>네번째</color>, 붐을 올려 주세요.");
                        }


                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.upper, 0f + (score_.score / 8), "붐"));   // 점점 더 땅속으로 내려가게..	
                        EnableRage();
                    }
                    break;

                case 9:
                    break;

                case 10:
                    if (upperAngle >= -4F) // 땅속에서 
