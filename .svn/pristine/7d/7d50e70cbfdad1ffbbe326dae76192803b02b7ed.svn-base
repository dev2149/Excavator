                        GuideSound("DigGuide/Guide_002_d", true);
                        SetMessage(text[score_.score / 20] + "<color=#00ff00>첫번째</color>, 붐을 내려 주세요.");
                    }


                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -10.0f, "붐"));
                    EnableRage();

                    break;

                case 3:



                    break;

                case 4:

                    //if (foreAngle >= -40.0f)
                    if (foreAngle >= -58.0f)
                    {
                        GuideSound("DigGuide/Guide_003_push", true);
                        SetMessage("<color=#00ff00>두번째</color>, 암을 밀어 주세요.");
                    }
                    else
                    {
                        //if (!audio_.isPlaying)
                        //{
                        //    audio_.clip = Resources.Load("DigGuide/Guide_003") as AudioClip;
