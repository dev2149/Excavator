                        GuideSound("DigGuide/Guide_003", true);
                        SetMessage("<color=#00ff00>두번째</color>, 암을 당겨 주세요.");
                    }
                    ++state;

                    axis = new List<AXIS>();
                    //axis.Add(AXIS.Create(diging.fore, -40.0f, "암"));
                    axis.Add(AXIS.Create(diging.fore, -58.0f, "암"));
                    EnableRage();


