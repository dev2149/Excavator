                    break;

                case 24:
                    if (score_.score >= 60)
                    {
                        GuideSound("DigGuide/Guide_011", true);
                        SetMessage("네번째 굴삭! 같은 방법으로 1번 더 하세요.");
                        ++state;
                        Invoke("ResetMessage", 3.0f);

                        axis = null;
                        EnableRage();
                    }
                    else
                        state = 1;
                    break;


                case 25:
                    if (GameEvent.TAG.DIG_POUR == tag)
                    {
                        GuideSound("DigGuide/Guide_013", true);
                        SetMessage("<color=#00ff00>평탄 작업을 시작하겠습니다.</color>버킷은 열고 암을 당기고 붐을 내리세요.");
                        ++state;

                        axis = new List<AXIS>();
                        axis.Add(AXIS.Create(diging.upper, -6.0f, "붐"));
                        //axis.Add(AXIS.Create(diging.fore, -15.0f, "암"));
                        axis.Add(AXIS.Create(diging.fore, -33.0f, "암"));
                        axis.Add(AXIS.Create(diging.bucket, -95.0f, "버킷"));
                        EnableRage();
                    }
                    break;

                case 26:

                    break;

                case 27:
                    stateflat = true; //안전한 작업을 위해 붐을 내려 주세요.
                    SetMessage("<color=#00ff00>평탄 첫번째,</color>암을 밀어주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    //axis.Add(AXIS.Create(diging.fore, -42.0f, "암"));
                    axis.Add(AXIS.Create(diging.fore, -60.0f, "암"));
                    EnableRage();
                    break;

                case 28:
                    break;

                case 29:
                    SetMessage("<color=#00ff00>평탄 두번째,</color>암을 당기면서 붐을 올려려주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -18.0f, "붐"));
                    //axis.Add(AXIS.Create(diging.fore, -30.0f, "암"));
                    axis.Add(AXIS.Create(diging.fore, -48.0f, "암"));
                    EnableRage();
                    stateflat = false;
                    break;

                case 30:
                    break;


                case 31:

                    GuideSound("DigGuide/Guide_014", true);
                    SetMessage("<color=#00ff00>자~ 이제 평탄마지막 단계입니다.</color>버킷을 땅에 닿게 해주세요.");
                    ++state;

                    axis = new List<AXIS>();
                    axis.Add(AXIS.Create(diging.upper, -2.0f, "붐"));

                    EnableRage();
                    break;

                case 32:
                    break;

                case 33:

                    GuideSound("DriveGuide/023", true);
                    SetMessage("수고하셨습니다. ");
                    if (ViveDigScene.instance.IsVR() == false)
                    {
                        for (int i = 0; i < ranges.Length; ++i)
                        {
                            ranges[i].gameObject.SetActive(false);
                        }
                    }
                    else
                    {
                        for (int i = 0; i < ranges_vr.Length; ++i)
                        {
                            ranges_vr[i].gameObject.SetActive(false);
                        }
                    }
                    Invoke("NextState", 1.5f);

                    break;
                case 34:
                    Map.SendMessage("ShowTutorial", true);
                    break;

            }
        }
    }

    void NextState()
    {
        ++state;
        CheckNotify(GameEvent.TAG.NONE);
    }

    void EnableRage()
    {
        int count = 0;

        if (null != axis)
        {
            count = axis.Count;
        }

        if (ViveDigScene.instance.IsVR() == false)
        {
            for (int i = 0; i < count; ++i)
            {
                ranges[i].gameObject.SetActive(true);
                ranges[i].axis = axis[i].@ref;
                ranges[i].transform.GetComponentInChildren<UILabel>().text = axis[i].targetName;
                ranges[i].targetAngle = axis[i].target;
            }

            for (int i = count; i < ranges.Length; ++i)
            {
                ranges[i].gameObject.SetActive(false);
            }
        }
        else
        {
            for (int i = 0; i < count; ++i)
            {
                ranges_vr[i].gameObject.SetActive(true);
                ranges_vr[i].axis = axis[i].@ref;
                ranges_vr[i].transform.GetComponentInChildren<Text>().text = axis[i].targetName;
                ranges_vr[i].targetAngle = axis[i].target;
            }

            for (int i = count; i < ranges_vr.Length; ++i)
            {
                ranges_vr[i].gameObject.SetActive(false);
            }
        }
    }

}
