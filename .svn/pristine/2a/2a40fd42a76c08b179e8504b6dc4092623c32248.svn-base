    public float getAxisJoystict(string key)
    {
        if (Input.GetAxisRaw(key) > 0.3f || Input.GetAxisRaw(key) < -0.3f)
        {
            return Input.GetAxisRaw(key);
        }
        else
            return 0.0f;
    }

    public bool getJoystict(string key)
    {
        if (Input.GetButtonDown(key))
            return true;
        else
            return false;
    }
