		//Capture Camera Render To Texture
		switch(_index)
		{
			case 0:
				break;
				
			case 11:
				capture = Right_fornt;
				break;
				
			case 12:
				capture = Left_front;
				break;
				
			case 13:
				capture = Right_rear;
				break;
				
			case 14:
				capture = Left_rear;
				break;
		}
			CaptureCam.localPosition = Vector3.Lerp(CaptureCam.localPosition, capture.localPosition, 0.1f);
			CaptureCam.localRotation = Quaternion.Lerp(CaptureCam.localRotation, capture.localRotation, 0.1f);

	}

