    void SetSpeedIV()
    {
        if (b_gearIV)        //기어가 들어가면 바늘이 떨리게
        {
            //   Debug.Log("1111");
            SpeedIV.localRotation = Quaternion.EulerRotation(new Vector3(0, 0, +0.1f));
            if (b_AccelIV)       //악셀을 밟았을때 속도계
            {

                //알피엠
                RPMIV.localRotation = Quaternion.Euler(90.0f, Random.Range(80.0f, 75.0f), 0.0f);

                if (MySpeed < Random.Range(-20.0f, -10.0f))
                {
                    //  스피드
                    MySpeed = MySpeed + Random.Range(10.0f, 25.0f) * Time.deltaTime;
                    SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
                }
                else
                {
                    MySpeed = MySpeed - 40.0f * Time.deltaTime;
                    SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
                }
            }
            else if (MySpeed > -97.0f)
            {
                MySpeed = MySpeed - 40.0f * Time.deltaTime;
                SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
            }
            else
            {
                MySpeed = MySpeed + 30.0f * Time.deltaTime;
                SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
            }

        }
        else if (MySpeed > -100.0f)
        {
            MySpeed = MySpeed - 40.0f * Time.deltaTime;
            SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
        }
        else
        {
            //MyRPM = 80.0f;
            //RPMIV.localRotation = Quaternion.Euler(90.0f, MyRPM, 0.0f);
        }
    }

   


    void Update()
    {
      //  getButton();
        //if (Input.GetKey(KeyCode.UpArrow))
        //{
            
        //    b_AccelIV = true;
        // //   MyRPM = MyRPM - ;
        //   // Debug.Log(MyRPM);
           
        //}
        //else
        //{
        //    b_AccelIV = false;
        //}
       

      

        //if (Input.GetKey(KeyCode.DownArrow))
        //{
        //    if (MySpeed > -101.0f)
        //    {
        //        MySpeed = MySpeed - 20.0f * Time.deltaTime;
        //        // Debug.Log(MySpeed);
        //        SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
        //    }
        //}

		if (keyboard) 
		{
			if (true == Input.GetKeyDown (KeyCode.Z)) 
			{
				gear = GEAR.N;
                b_gearIV = false;
			}
			else if (true == Input.GetKeyDown (KeyCode.X))
			{
				gear = GEAR.D;
                b_gearIV = true;
			} 
			else if (true == Input.GetKeyDown (KeyCode.C))
			{
				gear = GEAR.R;
                b_gearIV = true;
			}
			
			steer = Mathf.Clamp (Input.GetAxis ("Horizontal"), -1, 1);
			motor = Mathf.Clamp (Input.GetAxis ("Vertical"), 0, 1);
			brake = -1 * Mathf.Clamp (Input.GetAxis ("Vertical"), -1, 0);

            if (steer != 0)
            {
                GameEvent.notify(GameEvent.TAG.DRIVE_HANDLE);
            }

            if (motor > 0)
            {
                GameObject.Find("Main").GetComponent<UIDrivePedal>().OnPressAccel();
                GameObject.Find("Main").GetComponent<UIDrivePedal>().OnReleaseBreak();

                brake = 0;
            }
            else
            {
                GameObject.Find("Main").GetComponent<UIDrivePedal>().OnReleaseAccel();
                GameObject.Find("Main").GetComponent<UIDrivePedal>().OnPressBreak();

                if (MySpeed > -100.0f)
                {
                    MySpeed = MySpeed - 80.0f * Time.deltaTime;
                    SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
                }
            }
        }
        else if(!Mode_Caterpiller)
        {
            if (ViveDriveScene.instance.IsVR() == false)
            {
                UpdateButtons();
            }
            else
            {
                UpdateButtonsVR();
            }
        }

        float _forward = Forward;

      

        if (Mode_Caterpiller)
        {
            InputCaterpiller3();
        }
        else
        {

            if (isDone)
            {
                wheels[0].brakeTorque = brake_max * 1;
                wheels[1].brakeTorque = brake_max * 1;
                wheels[2].brakeTorque = brake_max * 1;
                wheels[3].brakeTorque = brake_max * 1;

                return;
            }

            wheels[0].motorTorque = motor_max * motor * _forward;
            wheels[1].motorTorque = motor_max * motor * _forward;
            wheels[2].motorTorque = motor_max * motor * _forward;
            wheels[3].motorTorque = motor_max * motor * _forward;

            wheels[0].brakeTorque = brake_max * brake;
            wheels[1].brakeTorque = brake_max * brake;
            wheels[2].brakeTorque = brake_max * brake;
            wheels[3].brakeTorque = brake_max * brake;

            wheels[0].steerAngle = steer_max * steer;
            wheels[1].steerAngle = steer_max * steer;

        }

        float _velocity = body.velocity.magnitude;
        _velocity = Mathf.Clamp(_velocity, 0.0f, 13.0f);
        body.velocity = body.velocity.normalized * _velocity;

        if (_velocity >= 0.1f)
            volume = Mathf.Clamp01(_velocity * 0.3f);

        if (true == Option.Instance.Sound) 
        {
            soundEngine.volume = Mathf.Lerp(0.0f, DeviceSound.Instance.Effect, volume);
			diesel.volume = Mathf.Lerp (0.0f, DeviceSound.Instance.Effect,120.0f);			
			diesel.GetComponent<AudioSource>().loop = true;
		} else {
			soundEngine.GetComponent<AudioSource>().volume = 0;
			diesel.GetComponent<AudioSource>().volume = 0;
		}


        SetSpeedIV();  //계기판
    }


    GEAR GetAxisCaterpillerInput(string inputName)
    {
        // 0 은 중립 , -1은 후진, 1은 전진으로 구분

        if (Input.GetAxisRaw(inputName) > 0.3f)
        {
            return GEAR.D;
        }
        else if (Input.GetAxisRaw(inputName) < -0.3f)
        {
            return GEAR.R;
        }
        else
        {
            return GEAR.N;
        }
    }
    void InputCaterpiller3()
    {
        if (Input.GetKeyDown(KeyCode.Alpha1))
        {
            GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchCenter();
        }
        else if (Input.GetKeyDown(KeyCode.Alpha2))
        {
            GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchFront();
        }
        else if (Input.GetKeyDown(KeyCode.Alpha3))
        {
            GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchRear();
        }
        else if(Input.GetKeyDown(KeyCode.Keypad4))
        {

        }

        float _forward = 0;

      
        float left = Mathf.Clamp(SerialCommunication3.Instance.analogValues[1], -1, 1);
        float right = Mathf.Clamp(SerialCommunication3.Instance.analogValues[2], -1, 1);

        steer = left - right;

        if (left > 0.2f || right > 0.2f)
        {
            _forward = 1;
            brake = 0;

            if (steer < -1)
            {
                LeftAdd += 0.002f;
                RightAdd -= 0.002f;
            }
            else if (steer > 1)
            {
                LeftAdd -= 0.002f;
                RightAdd += 0.002f;
            }
            else if (steer == 0)
            {
                LeftAdd -= 0.002f;
                RightAdd -= 0.002f;
            }
            else if (steer > 0)
            {
                LeftAdd -= 0.002f;
            }
            else
            {
                RightAdd -= 0.002f;
            }
        }
        else if (left < -0.2f || right < -0.2f)
        {
            _forward = -1;
            brake = 0;

            if (steer == 0)
            {
                LeftAdd += 0.002f;
                RightAdd += 0.002f;
            }
            else if (steer > 0)
            {
                LeftAdd += 0.002f;
            }
            else
            {
                RightAdd += 0.002f;
            }
        }
        else
        {
            brake = 1;
            _forward = 0;
        }

        //가속도 부분 임의로 정함
        motor = 1 + Mathf.Abs(left + right) * 0.5f;
        Caterpillers[0].material.SetTextureOffset("_MainTex", new Vector2(0, LeftAdd));
        Caterpillers[1].material.SetTextureOffset("_MainTex", new Vector2(0, RightAdd));

        float _motorMax = motor_max;

        if(gear == GEAR.R)
        {
            _motorMax = motor_max/ 2;
        }
        else if(gear == GEAR.N)
        {
            _motorMax = motor_max;
        }
        else
        {
            _motorMax = motor_max * 2f;
        }


        wheels[0].motorTorque = _motorMax * motor * _forward;
        wheels[1].motorTorque = _motorMax * motor * _forward;
        wheels[2].motorTorque = _motorMax * motor * _forward;
        wheels[3].motorTorque = _motorMax * motor * _forward;

        wheels[0].brakeTorque = brake_max * brake;
        wheels[1].brakeTorque = brake_max * brake;
        wheels[2].brakeTorque = brake_max * brake;
        wheels[3].brakeTorque = brake_max * brake;

        wheels[0].steerAngle = steer_max * steer;
        wheels[1].steerAngle = steer_max * steer;
    }

    
}
