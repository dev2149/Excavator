            LogManager.Instance.Save("Center Camera!");
        }

        //후방
        if (Input.GetButtonDown("Back Camera"))
        {
            GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchRear();
            //LogManager.Instance.Save("");
