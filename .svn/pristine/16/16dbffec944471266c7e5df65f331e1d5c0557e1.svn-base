    private float Forward
    {
        get
        {
            switch (gear)
            {
                case GEAR.D:
                    return 1.0f;
                case GEAR.R:
                    return -1.0f;
			}

            return 0.0f;
        }
    }


    void Start()
    {
        body.centerOfMass = centerOfMass.localPosition;
        //  Debug.Log(GameObject.Find("Main").gameObject.name);
        //    Input.ResetInputAxes();

        b_AccelIV = false;
        b_gearIV = false;
        MySpeed = -100.0f;
        MyRPM = 80.0f;

        if (VRSettings.isDeviceActive == false)
        {
            keyboard = true;
        }
    }

    public void UpdateButtonsVR()
    {
        if (PlayerPrefs.GetInt("Gear") == 1)
        {

            gear = GEAR.D;
            b_gearIV = true;
        }
        else if (PlayerPrefs.GetInt("Gear") == 0)
        {
            gear = GEAR.N;
            b_AccelIV = false;
            b_gearIV = false;
        }
        else if (PlayerPrefs.GetInt("Gear") == 2) //후진모드
        {
            gear = GEAR.R;
            b_gearIV = true;
        }

        ////확대
        //if (Input.GetButtonDown("Expand Camera") && GameObject.Find("MiniTexture").activeSelf == true)
        //{
        //    if (GameObject.Find("Zoom").GetComponent<BoxCollider>().enabled == true)
        //    {
        //        GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchExpand();
        //    }
        //}

        //핸들
        if (ViveDriveScene.instance.steering.GetWheelAngle() > 0.1f || ViveDriveScene.instance.steering.GetWheelAngle() < -0.1f)//Input.GetAxisRaw("Handle") > 0.1f || Input.GetAxisRaw("Handle") < -0.1f)
        {
            steer = Mathf.Clamp(-ViveDriveScene.instance.steering.GetWheelAngle(), - 1, 1);
            GameEvent.notify(GameEvent.TAG.DRIVE_HANDLE);
        }


        //가속 패달
        if (ViveDriveScene.instance.steering.GetAcceleraterPedal() > 0f)
        {
            GameObject.Find("Main").GetComponent<UIDrivePedal>().OnPressAccel();
            motor = Mathf.Clamp(ViveDriveScene.instance.steering.GetAcceleraterPedal(), 0, 1);
            b_AccelIV = true;
        }
        else
        {
            GameObject.Find("Main").GetComponent<UIDrivePedal>().OnReleaseAccel();
            b_AccelIV = false;
        }

        // 브레이크
        if (ViveDriveScene.instance.steering.GetBrakePedal() > 0f)
        {
            GameObject.Find("Main").GetComponent<UIDrivePedal>().OnPressBreak();

            brake = Mathf.Clamp(ViveDriveScene.instance.steering.GetBrakePedal() + 0.5f, 0, 1);

            if (MySpeed > -100.0f)
            {
                MySpeed = MySpeed - 80.0f * Time.deltaTime;
                SpeedIV.localRotation = Quaternion.Euler(90, MySpeed, 0);
            }
        }
        else
        {
            GameObject.Find("Main").GetComponent<UIDrivePedal>().OnReleaseBreak();
            brake = 0;
        }
    }


    public void UpdateButtons()
    {
        if (!b_Once)
        {
            b_Once = true;
         //   Input.ResetInputAxes();
        }
        //else
        //{
        //    b_Once = false;
        //}
        ////고속(2단)
        //if (Input.GetButton("High Speed"))
        //{
        //    GameObject.Find("Main").GetComponent<UIDrivePedal>().OffGearTwo();

        //}
        //else if (Input.GetButton("Low Speed"))     //저속(1단)
        //{
        //    GameObject.Find("Main").GetComponent<UIDrivePedal>().OnGearTwo();
        //}

        //드라이브 모드
        if (PlayerPrefs.GetInt("Gear") == 1)
        {
           // if (gear != GEAR.D)
           // {
            if (!LogManager.Instance.Exist("GEAR : " + gear.ToString()))
            {
                LogManager.Instance.Save("GEAR : " + gear.ToString());
            }
           // }

            gear = GEAR.D;
         //  GameObject.Find("Main").GetComponent<UIDriveGear>().OnSwitchD();
            b_gearIV = true;

            //LogManager.Instance.Save("");
            
           
        }
        else if (PlayerPrefs.GetInt("Gear") == 0)
        {
            //if(gear != GEAR.N)
            //{
        
            if (body.gameObject.name != "Excavator_caterpiller" && !LogManager.Instance.Exist("GEAR : " + gear.ToString()))
            {
                LogManager.Instance.Save("GEAR : " + gear.ToString());
            }
           // }

            gear = GEAR.N;
           // GameObject.Find("Main").GetComponent<UIDriveGear>().OnSwitchN();
            b_AccelIV = false;
            b_gearIV = false;

            //LogManager.Instance.Save("");
          
        }
        else if (PlayerPrefs.GetInt("Gear") == 2) //후진모드
        {
            //if (gear != GEAR.R)
           // {
            if (!LogManager.Instance.Exist("GEAR : " + gear.ToString()))
            {
                LogManager.Instance.Save("GEAR : " + gear.ToString());
            }
           // }

            gear = GEAR.R;
           // GameObject.Find("Main").GetComponent<UIDriveGear>().OnSwitchR();
            b_gearIV = true;

            //LogManager.Instance.Save("");
        }

        //카메라
        //전방
        if (Input.GetButtonDown("Front Camera"))
        {
           GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchCenter();
            //LogManager.Instance.Save("");
            LogManager.Instance.Save("Front Camera!");
        }

        //센터
        if (Input.GetButtonDown("Center Camera"))
        {
            GameObject.Find("Main").GetComponent<UIDriveCamera>().OnSwitchFront();
