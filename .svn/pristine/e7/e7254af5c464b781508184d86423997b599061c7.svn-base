                    break;

                case 21:
                    desc = "[ff0000][실격요인][-] \n버킷의 높이가 \n폴대보다 높습니다.";

                    if (!LogManager.Instance.Exist("[실격요인] 버킷의 높이가 폴대보다 높습니다."))
                    {
