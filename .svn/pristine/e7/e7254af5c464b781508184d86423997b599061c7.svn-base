                    desc = "<color=#ff0000>[실격요인]</color> 흙량이 부족합니다..";

                    lack_soil += 1;
                    break;

                case 17:
                    GuideSound("DigCaution/Caution_007", true);
                    desc = "<color=#ff0000>[실격요인]</color> 흙량이 부족합니다..";

                    break;

                case 18:
                    GuideSound("DigCaution/Caution_008", true);
                    desc = "<color=#ff0000>[감점요인]</color> 버킷을 열고 작업을 시작해주세요.";

                    Upper.transform.rotation = Quaternion.Euler(new Vector3(-15.0f, 0.0f, 0.0f));
                    break;

                case 19:
                    GuideSound("DigCaution/Caution_009", true);
                    desc = "<color=#ff0000>[감점요인]</color> 버킷이 땅속에 있습니다.";

                    break;

                case 20:
                    desc = "<color=#ff0000>[실격요인]</color> 버킷의 높이가 폴대보다 낮습니다.";

                    int_foul_exit++;
                    break;

                case 21:
                    desc = "<color=#ff0000>[실격요인]</color> 버킷의 높이가 폴대보다 높습니다.";

                    int_foul_exit++;
                    break;
            }
        }


        if (index == 2 || index == 7 || index == 8 || index == 11 || index == 12 || index == 13 || index == 16 || index == 17 || index == 20 || index == 21)
        {
            Result = desc;
        }


        if (!message.activeSelf) //경고창이 떠있을 때에는 다시 반복하지 않아야함.
            message.SetActive(true);


        if (ViveDigScene.instance.IsVR() == false)
        {
            if (index >= 17)
                message.GetComponentInChildren<UISprite>().spriteName = string.Format("ex_PpMsg_icon_07");
            else
                message.GetComponentInChildren<UISprite>().spriteName = string.Format("ex_PpMsg_icon_{0}", index.ToString("D2"));
            message.GetComponentInChildren<UILabel>().text = desc;

            NGUITools.PlaySound(failwhistle, DeviceSound.Instance.Effect);
        }
        else
        {
            message.transform.Find("img_icon").GetComponent<Image>().sprite = getPpMsgIcon(index);
            message.GetComponentInChildren<Text>().text = desc;
            //효과음... 
            NGUITools.PlaySound(failwhistle, DeviceSound.Instance.Effect);
        }

        yield return new WaitForSeconds(2.0f);

        message.SetActive(false);

        TestCautionResult(index);  // 실격일때만 가능.
    }

    private Sprite getPpMsgIcon(int index)
    {
        Sprite sp = null;

        String spName = "";
        if (index >= 17)
            spName = string.Format("ex_PpMsg_icon_07");
        else
            spName = string.Format("ex_PpMsg_icon_{0}", index.ToString("D2"));

        for (int i = 0; i < PpMsgIcon.Length; i++)
        {
            if (PpMsgIcon[i].name.Equals(spName))
            {
                sp = PpMsgIcon[i];
            }
        }

       return sp;
    }

    void TestCautionResult(int index) //bool pass  //무조건 실패했을경우.
    {
        if (Diging.tutorial) //연습모드는 꺼지거라.
            return;

        if (index == 10 && mistake <= 4 || index == 9 && mistake <= 4 || index == 18 && mistake <= 4) //감점요인. 실격은 아님.
        {

        } 
        else
        {
            Debug.Log(Result);
            result.SetActive(true);
            if (ViveDigScene.instance.IsVR() == false)
            {
                result.GetComponent<UIDigResult>().label.text = Result;
            }
            else
            {
                result.GetComponent<ViveResultVR>().label.text = Result;
            }
            Sound.SetActive(false);
            result.SendMessage("OnOpen", false);

            Diging.play = false;
        }
    }


    void ShowTutorial(bool clear)
    {
        if (!Diging.tutorial) //시험일때는 안됨.
            return;

        Foul[0] = int_foul_shake;
        Foul[1] = int_foul_exit;
        Foul[2] = int_foul_soil;
        Foul[3] = bucket.int_foul_overload;

        tutorial.SetActive(true);
        Sound.SetActive(false);
        Diging.play = false;

        if (clear)
        {
            tutorial.SendMessage("DigOnOpen", Foul);
        }
        else
        {
            tutorial.SendMessage("DigTutorial", Foul);
        }
    }

    void PositionReset()
    {
        if (ViveDigScene.instance.IsVR() == false)
        {
            Application.LoadLevel("dig");
        }
        else
        {
            Application.LoadLevel("ViveDig");
        }
    }

    void UpdateLaptime()
    {
        if (false == updateTime)
            return;

        if (true == Diging.tutorial)
        {
            if (ViveDigScene.instance.IsVR() == true)
            {
                DeviceSound.Instance.practiceLapTime += Time.deltaTime;

                int minute2 = Mathf.FloorToInt(DeviceSound.Instance.practiceLapTime / 60.0f);
                int second2 = Mathf.FloorToInt(DeviceSound.Instance.practiceLapTime) % 60;
                int msecond2 = Mathf.FloorToInt(DeviceSound.Instance.practiceLapTime * 100) % 100;

                ViveDigScene.instance.laptime_Canvas.text = string.Format("{0:00}:{1:00}:{2:00}", minute2, second2, msecond2);
            }
            return;
        }

        _laptime -= Time.deltaTime;

        int minute = Mathf.FloorToInt(_laptime / 60.0f);
        int second = Mathf.FloorToInt(_laptime) % 60;
        int msecond = Mathf.FloorToInt(_laptime * 100) % 100;

        if (ViveDigScene.instance.IsVR() == false)
        {
            laptime.text = string.Format("{0:00}:{1:00}:{2:00}", minute, second, msecond);
        }
        else
        {
            //ViveDigScene.instance.laptime.text = string.Format("{0:00}:{1:00}:{2:00}", minute, second, msecond);
            //ViveDigScene.instance.laptime_mesh.text = string.Format("{0:00}:{1:00}:{2:00}", minute, second, msecond);
            ViveDigScene.instance.laptime_Canvas.text = string.Format("{0:00}:{1:00}:{2:00}", minute, second, msecond);
        }

        if (0.01f >= _laptime && updateTime == true)
        {
            _laptime = 0.0f;
            updateTime = false;
            StartCoroutine(ShowMessage(2));

        }
    }

    public void OnVibration()
    {
        if (!Option.Instance.Vibration)
            return;
    }


    void GuideSound(string str, bool on)
    {
        if (ViveDigScene.instance.IsVR())
        {
            DeviceSound.Instance.Play(Resources.Load(str.ToString()) as AudioClip, DeviceSound.Instance.Effect);
            return;
        }

        if (ViveDigScene.instance.IsVR() == false)
        {
            if (on)
            {
                if (!audio_.isPlaying)
                {
                    audio_.clip = Resources.Load(str.ToString()) as AudioClip;
                    audio_.Play();
                }
                on = false;
            }
        }
    }

}

