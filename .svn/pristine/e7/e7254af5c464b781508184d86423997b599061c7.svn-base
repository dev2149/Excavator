                    break;

                case 7:
                    desc = "<color=#ff0000>[실격요인]</color> 굴삭작업 영역이 아닙니다.";
                    break;

                case 8:
                    GuideSound("DigCaution/Caution_002", true);
                    desc = "<color=#ff0000>[실격요인]</color> 엔진이 과부하되었습니다.";

