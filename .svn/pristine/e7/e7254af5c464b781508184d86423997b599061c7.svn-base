                    desc = "[ff0000][감점요인][-] \n버킷이 \n땅속에 있습니다.";

                    if (!LogManager.Instance.Exist("[감점요인] 버킷이 땅속에 좌/우로 움직임이 있습니다."))
                    {
                        LogManager.Instance.Save("[감점요인] 버킷이 땅속에 좌/우로 움직임이 있습니다.");
                    }
                    break;

                case 20:
