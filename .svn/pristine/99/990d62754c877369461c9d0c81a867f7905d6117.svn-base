Shader "Projector/Line" {
   Properties {
      _ShadowTex ("Cookie", 2D) = "white" { TexGen ObjectLinear }
   }

   Subshader {
      Tags { "RenderType"="Transparent-1" }
      Pass {
         ZWrite Off
         Fog { Color (1, 1, 1) }
         Blend SrcAlpha OneMinusSrcAlpha
		 Offset -1, -1


         SetTexture [_ShadowTex]
		 {
            combine texture
            Matrix [_Projector]
         }



      }
   }
}
