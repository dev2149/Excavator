    void SetGear()
    {
        int gearValue = 0;

        if (uiDriveGear == null && GameObject.Find("Main") != null)
        {
            uiDriveGear = GameObject.Find("Main").GetComponent<UIDriveGear>();
        }

        if (dv == null && GameObject.Find("Drive") != null)
            dv = GameObject.Find("Drive").GetComponent<Driving>();

        if (dv != null && dv.keyboard)
        {
            gearValue = (int)dv.gear;
            if (gearValue == 2) gearValue = -1;
        }

        if (ViveDriveScene.instance != null && dv != null && !dv.keyboard)
        {
            gearValue = (int)ViveDriveScene.instance.steering.GetGearType();
            // Debug.Log(gearValue);
        }

        //드라이브 모드
        if (gearValue == 1)
        {
            gear = GEAR.D;

            PlayerPrefs.SetInt("Gear", 1);

            if(GameObject.Find("Main") != null)
            GameObject.Find("Main").GetComponent<UIDriveGear>().OnSwitchD();
            //if (uiDriveGear != null)
            //{
            //    uiDriveGear.OnSwitchD();
            //}
        }

        else if (gearValue == 0)
        {
            gear = GEAR.N;
            PlayerPrefs.SetInt("Gear", 0);

            if (GameObject.Find("Main") != null)
                GameObject.Find("Main").GetComponent<UIDriveGear>().OnSwitchN();
            //if (uiDriveGear != null)
            //{
            //    uiDriveGear.OnSwitchN();
            //}
        }
        else if (gearValue == -1) //후진모드
        {
            gear = GEAR.R;
            PlayerPrefs.SetInt("Gear", 2);

            if (GameObject.Find("Main") != null)
                GameObject.Find("Main").GetComponent<UIDriveGear>().OnSwitchR();
            //if (uiDriveGear != null)
            //{
            //    uiDriveGear.OnSwitchR();
            //}
        }
        //else if (Input.GetButtonUp("Reverse"))
        //{
        //    gear = GEAR.N;
        //    PlayerPrefs.SetInt("Gear", 0);
        //}
       
    }

